# Copy this file to .env and fill in your node credentials before running:
#   docker compose up -d

# Deployment ID of the node's registration Google Apps Script Web App
# (the part between /macros/s/ and /exec in the Web App URL)
MAILBOX_DEPLOYMENT_ID=

# AUTH_KEY configured in the node's registration apps_script/Code.gs
MAILBOX_AUTH_KEY=

# Private key generated with:
#   docker compose --profile tools run --rm keygen
MAILBOX_NODE_KEY=

# Optional: local status page showing active session count and the mtn:// node string.
# Bound to 127.0.0.1 by default so the mtn:// string is not exposed publicly.
# Set STATUS_LISTEN= (empty) to disable the status page completely.
STATUS_LISTEN=:7860
STATUS_BIND=127.0.0.1
STATUS_PORT=7860
